[2m11[10G[22m ```bash[6C[1B[2m12[10G[22m # I[15Gto th[23Gurrent[30Gproject[39m[K[6C[1B[38;5;231m[2m13[10G[22m npx ldo-ai[6C[1B[2m14[10G[22m [39m[K[5C[1B[38;5;167m[48;5;52m 13 -[38;5;231m# Globally (available in all Claude Code sessions)                                                     [5C[1B[38;5;77m[48;5;22m 15 +[38;5;231m# Globally (available in [48;5;28mevery[48;5;22m Claude Code [48;5;28msession[48;5;22m)                                                    [6C[1B[49m[2m16[10G[22m npx ldo-ai --global[39m[K[6C[1B[38;5;231m[2m17[10G[22m [5C[1B[38;5;167m[48;5;52m 16 -[38;5;231m# Custom directory (non-standard config location)                                                      [5C[1B[38;5;77m[48;5;22m 18 +[38;5;231m# Custom directory, if your config lives somewhere non-standard                                        [5C[1B[49m[2m 19 [22m npx ldo-ai --target /opt/claude/.claude[1B[39m [3G   [38;5;231m[2m 20 [22m ```[39m[K[5C[1B[38;5;231m[2m 21 [22m [2C[1B[39m   [38;5;167m[48;5;52m 20 -[38;5;231mAfter install, set your model routing in `.claude/ldo-config.json`. Then in Claude Code:               [5C[1B[38;5;77m[48;5;22m 22 +[38;5;231m[48;5;28mSet[48;5;22m your model routing in `.claude/ldo-config.json`[48;5;28m,[48;5;22m [48;5;28mthen[48;5;22m in Claude Code:                              [1B[49m[39m [3G   [38;5;231m[2m 23 [22m [39m[K[5C[1B[38;5;231m[2m 24 [22m ```[1B[39m [3G   [38;5;231m[2m 25 [22m /ldo "add rate limiting middleware"[39m[40;1H[38;3H[?25h[?25l[H[2C[33B[38;5;216mTinkering…[39m[40;1H[38;3H[?25h]0;⠂ Claude Code]0;⠐ Claude Code]0;⠂ Claude Code]0;⠐ Claude Code]0;⠂ Claude Code]0;⠐ Claude Code]0;⠂ Claude Code[?25l[H[4C[33B[38;5;174mnkering…[19G[38;5;246m6[28G7[39m[40;1H[38;3H[?25h[?25l[H[33B[38;5;174m✢[4Gi[39m[40;1H[38;3H[?25h[?25l[H[33B[38;5;174m*[3GT[39m[40;1H[