facts,[85Gminimal[93Gfix[97Gloops,[104Glightweight[2C[1BSetup,[10Gand[14Gbudget-aware[27GDocs[32Gskipping,[42Git's[47Groughly[55G50-60%[62Gfewer[68Gtokens[75Gper[79Grun.[1B[K[1B[38;5;246m✻[3GBaked for 3m 33s[1B[39m[K[1B[38;5;153m←[3G[38;5;246mchannel-dev-lead:[21G[39mНормусь.[30GА[32Gчто[36Gбудет[42Gс[44Gкэшем[50Gпри[54Gсмене[60Gмоделей?[69GОн[72Gже[75Gпоплы…[2C[1B[K[2C[1B[38;5;246mThought for [1m34s[22m, called channel-dev-lead [1B[39m[K[1B[38;5;231m●[3G[39mОбновляю[12Gконфиг[19Gи[21Gworkflow[30G—[32Gделаю[38Gстратегию[48Gкэширования[60Gявной[66Gи[68Gнастраиваемой.[1B[K[1B  [38;5;246mThought for [1m3s[22m, read [1m1[22m file [39m[K[5C[1B[K[1B[38;5;246m●[3G[39m[1mUpdate[22m(.claude/workflows/ldo.js)[K[2C[2B[38;5;180mMustering…[39m[40;1H[38;3H[?25h[?25l[H[2C[33B[38;5;216mMustering…[39m[40;1H[38;3H[?25h[?25l[H[33B[38;5;174m✢[16G[38;5;246m9[39m[40;1H[38;3H[?25h]0;⠂ Claude Code[?25l[H[33B[38;5;174m*[39m[40;1H[38;3H[?25h[?25l[H[33B[38;5;174m✶[39m[40;1H[38;3H[?25h[?25l[H[33B[38;5;174m✻[39m[40;1H[38;3H[?25h[?25l[H[33B[38;5;174m✽[25G[38;5;246m4[39m[40;1H[38;3H[?25h[?25l[H[2C[33B[38;5;180mMustering…[39m[40;1H[38;3H[?25h]0;⠐ Claude Code[?25l[H[33B[38;5;174m✻[3GMustering…[15G[38;5;246m50[39m[40;1H[38;3H[?25h[?25l[H[33B[38;5;174m✶[39m[40;1H[38;3H[?25h[?25l[H[33B[38;5;174m*[39m[40;1H[38;3H[?25h[?25l[H[33B[38;5;174m✢[39m[40;1H[38;3H[?25h[?25l[H[33B[38;5;174m·[3G[38;5;180mMustering…[39m[40;1H[38;3H[?25h[?25l[H[2C[33B[38;5;216mMustering…[39m[40;1H[38;3H[?25h]0;⠂ Claude Code[?25l[H[33B[38;5;174m✢[16G[38;5;246m1[39m[40;1H[38;3H[?25h[?25l[H[33B[38;5;174m*[39m[40;1H[38;3H[?25h[?25l[H[6G[38;5;231m[2m 148 [22m [39m[K[5C[1B[38;5;231m[2m 149 [22m [38;5;242m// Build the shared text prefix from Planner's codebase snapshot.[39m[K[5C[1B[38;5;167m[48;5;52m 150 -[38;5;231m// This prefix is IDENTICAL across all downstream agent prompts →                                     [5C[1B[38;5;167m 151 -[38;5;231m// Claude's server-side prompt caching hits on calls 2-5.                                             [5C[1B[38;5;167m 152 -[38;5;231m// Cost: codebase read happens ONCE (in Planner), reused N times.                                     [6C[1B[38;5;77m[48;5;22m150 +[38;5;242m// This prefix is IDENTICAL [48;5;28mbytes [48;5;22macross all downstream agent prompts[48;5;28m.[5C[1B[38;5;77m[48;5;22m 151 +[38;5;242m//[38;5;231m                                                                                                    [5C[1B[38;5;77m 152 +[38;5;242m// ⚠ CACHE STRATEGY (critical):[38;5;231m                                                                       [5C[1B[38;5;77m 153 +[38;5;242m// Anthropic prompt cache is keyed on (model_id + prefix_bytes).[38;5;231m                                      [6C[1B[38;5;77m154 +[38;5;242m// → Same model + same CTX prefix = cache HIT (≈10× cheaper input).[6C[1B[38;5;77m1[9G5 +[38;5;242m// → Different model + same CTX prefix = cache MISS (cold, full price).[38;5;231m                               [6C[1B[38;5;77m156 +[38;5;242m//[38;5;231m                                                   [5C[1B[38;5;77m 157 +[38;5;242m// Therefore:[38;5;231m                                                                                         [1B[49m[39m     [38;5;77m[48;5;22m 158 +[38;5;242m//   Coder, Reviewer, Setup, Docs should use the SAME model for maximum cache reuse.[38;5;231m                  [5C[1B[38;5;77m 159 +[38;5;242m//   Cache hits are per-model, not per-request — the first call for each model is cold,[38;5;231m               [2C[1B[49m[39m   [38;5;77m[48;5;22m 160 +[38;5;242m//   subsequent calls to the SAME model with the SAME prefix are hot.[38;5;231m                                 [5C[1B[38;5;77m 161 +[38;5;242m//[38;5;231m                                                                                                    [1B[49m[39m [3G   [38;5;77m[48;5;22m 162 +[38;5;242m//   Only deviate from this when the adversarial benefit of a different reviewer model[38;5;231m                [49m[39m[K[2C[1B  [6G[38;5;77m[48;5;22m 163 +[38;5;242m//   outweighs the cache tax (complex tasks with `reviewerDifferentModel: true`).[38;5;231m                     [49m[39m[K[2C[1B   [38;5;77m[48;5;22m 164 +[38;5;242m//[38;5;231m                                                                                                    [5C[1B[38;5;77m 165 +[38;5;242m//   Planner and Bootstrapper don't matter — they run BEFORE the CTX prefix exists.[38;5;231m                   [1B[49m[39m [3G   [38;5;77m[48;5;22m 166 +[38;5;242m//   Docs uses haiku by default — one cold start per run, acceptable for its low cost.[38;5;231m                [5C[1B[38;5;77m 167 +[38;5;242m//[38;5;231m                                                                                                    [1B[49m[39m [3G   [38;5;77m[48;5;22m 168 +[38;5;242m// Typical cache profile (medium, reviewerDifferentModel: false):[38;5;231m                                     [5C[1B[38;5;77m 169 +[38;5;242m//   Coder(sonnet)    = COLD → populates sonnet cache[38;5;231m                                                 [2C[1B[49m[39m   [38;5;77m[48;5;22m 170 +[38;5;242m//   Reviewer(sonnet) = HOT  ✓[38;5;231m                                                                        [5C[1B[38;5;77m 171 +[38;5;242m//   Setup(sonnet)    = HOT  ✓[38;5;231m                                                                        [1B[49m[39m [3G   [38;5;77m[48;5;22m 172 +[38;5;242m//   Docs(haiku)      = COLD → first time haiku sees this prefix (but haiku is cheap)[38;5;231m                 [5C